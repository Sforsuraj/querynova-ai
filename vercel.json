{
  "version": 2,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "backend/**/*.py",
        "backend/database/ecommerce.db"
      ]
    },
    "api/[...path].py": {
      "includeFiles": [
        "backend/**/*.py",
        "backend/database/ecommerce.db"
      ]
    }
  }
}
